[
  {
    "Name": "YouDied",
    "Pattern": "^You have been slain by (?<who>.+)\\.$",
    "DisplayText": "Killed by {who}!",
    "Severity": "Alarm"
  },
  {
    "Name": "NearbyPlayerDown",
    "Pattern": "has (?:killed|slain) (?<who>[A-Za-z][\\w']*(?: [A-Za-z][\\w']*)?)\\.$",
    "DisplayText": "{who} went down!",
    "Severity": "Alert"
  },
  {
    "Name": "FeignDeathReminder",
    "Pattern": "You feel much better\\.",
    "DisplayText": "Feign Death recovered",
    "Severity": "Info"
  },
  {
    "Name": "ExampleZoneScoped",
    "Pattern": "You feel much better\\.",
    "DisplayText": "Feign Death recovered (this copy of the rule only evaluates while you're in Loping Plains)",
    "Severity": "Info",
    "Zone": "Loping Plains"
  },
  {
    "Name": "ExampleSuppressCooldown",
    "Pattern": "has (?:killed|slain) (?<who>[A-Za-z][\\w']*(?: [A-Za-z][\\w']*)?)\\.$",
    "DisplayText": "{who} went down (won't repeat for 30s even if this matches again in that window)",
    "Severity": "Alert",
    "SuppressSeconds": 30
  },
  {
    "Name": "ExampleDelayedAlert",
    "Pattern": "^You have been slain by (?<who>.+)\\.$",
    "DisplayText": "Delayed example - killed by {who} (shown 3s after the actual log line, not instantly)",
    "Severity": "Alarm",
    "DelaySeconds": 3
  },
  {
    "Name": "ExampleRequirePlayerMatch",
    "Pattern": "(?<who>\\w+) is afflicted with a curse\\.",
    "DisplayText": "You are cursed!",
    "Severity": "Alarm",
    "RequirePlayerMatch": "who"
  }
]
